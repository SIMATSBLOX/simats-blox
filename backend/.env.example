# Used by backend/index.js (set in repo root .env).

PORT=8184
CLIENT_ORIGIN=http://localhost:8183
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Optional: direct database URL used by `npm run db:migrate`.
# SUPABASE_DB_URL=postgresql://postgres:password@db.host:5432/postgres

# Must match JWT in backend/index.js and backend/src/config/jwt.js (Socket.IO auth).
# JWT_SECRET=your-long-random-secret
